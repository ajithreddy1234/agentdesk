# ---------- required for chat ----------
OPENROUTER_API_KEY=
# any OpenRouter model with tool calling
LLM_MODEL=openai/gpt-4o-mini
# LLM-as-judge used by the evaluation
JUDGE_MODEL=openai/gpt-4o-mini

# ---------- auth (change all of these) ----------
# signs login tokens; keep stable so sessions survive restarts
AUTH_SECRET=change-me-to-a-long-random-string
# demo: every customer signs in with their id + this password
DEMO_CUSTOMER_PASSWORD=demo-customer
# supervisor accounts, comma-separated name:password
SUPERVISORS=supervisor:demo-supervisor
# internal token the agent's tools use for the order/refund service
SERVICE_TOKEN=change-me-service-token

# ---------- optional ----------
# web_search tool (Tavily free tier: 1,000 searches/month)
TAVILY_API_KEY=
# tracing (cloud.langfuse.com free tier)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
AUTO_REFUND_LIMIT=500
# leave empty for the real clock; set an ISO time only to freeze time for demos
AGENTDESK_NOW=
